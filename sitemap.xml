---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_items = site.pages | concat: site.posts | sort: 'url' %}
  {% for item in sitemap_items %}
    {% if item.url and item.sitemap != false and item.published != false %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
    {% if item.date %}<lastmod>{{ item.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
    {% endif %}
  {% endfor %}
</urlset>
